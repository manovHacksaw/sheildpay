{
  "manifest_version": 3,
  "name": "ShieldCheckout",
  "version": "0.1.0",
  "description": "Pay at checkout with shielded Zcash.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://api.shieldcheckout.example/*",
    "http://localhost:8793/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
