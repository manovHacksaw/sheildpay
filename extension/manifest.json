{
  "manifest_version": 3,
  "name": "ShieldCheckout",
  "version": "0.1.0",
  "description": "Pay at checkout with shielded Zcash.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://api.shieldcheckout.example/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.flipkart.com/*",
        "https://*.flipkart.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ShieldCheckout",
    "default_popup": "src/popup/index.html"
  }
}