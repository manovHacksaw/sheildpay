# ShieldCheckout demo config: TESTNET ZEC in, REAL Bitrefill cards out (paid from your Bitrefill balance).
# Copy to .env.testnet and fill in. In this mode the server binds to 127.0.0.1 only, because free testnet
# coins would otherwise let anyone on your network spend your Bitrefill balance.

# bitrefill.com/account/developers -> API Keys. Set USD as the PRIMARY store-credit currency (see README).
BITREFILL_API_KEY=
# Optional: enables the LLM planner at /agent. Empty = rule-based planner (same pricing and guardrails).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

ZCASH_NETWORK=test
# Viewing key of YOUR receiving wallet: cargo run --example gen_wallet -- wallet-seed-testnet.txt test (in watcher/)
ZCASH_UFVK=
ZCASH_LIGHTWALLETD=https://testnet.zec.rocks:443
WATCHER_URL=http://127.0.0.1:8788

TESTNET_REAL_PURCHASES=1
ENABLED_MERCHANTS=www.flipkart.com
PER_ORDER_CAP_USD=10
DAILY_CAP_USD=25
PORT=8787
