# All required for live (mainnet) operation. The server refuses to create orders if any is missing.
BITREFILL_API_KEY=
ZCASH_UFVK=            # Orchard incoming viewing key ONLY (never a spending key)
ZCASH_LIGHTWALLETD=    # e.g. https://zec.rocks:443
# Funding: orders are paid from your Bitrefill account balance (your float). Keep it topped up.
PER_ORDER_CAP_USD=100
DAILY_CAP_USD=500
